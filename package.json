{
  "name": "obsidian-manager",
  "version": "1.1.0",
  "description": "Obsidian 知识库管理工具",
  "author": "xjyammia-star",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.obsidian.manager",
    "productName": "Obsidian管理工具",
    "icon": "assets/icon",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "obsidian-manager-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "obsidian-manager-setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "xjyammia-star",
      "repo": "Obsidian-",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chokidar": "^3.5.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "jsdom": "^24.1.3",
    "pdf-parse": "^2.4.5"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "fsevents@2.3.3": true
  }
}
